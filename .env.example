# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical base URL where this deployment is hosted.
# - Local / AI Studio dev: automatically injected at runtime (or http://localhost:3000)
# - Vercel Production: set to https://nuvvo-1-nu.vercel.app (fallback enforced automatically)
APP_URL="MY_APP_URL"

# Supabase configuration for public.food_items centralized catalog
NEXT_PUBLIC_SUPABASE_URL="https://bitxmpjuetvfbhdyfvok.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_-uXD4j7ITcsUZWT7_IDQ3A_AXLPWBCX"
VITE_SUPABASE_URL="https://bitxmpjuetvfbhdyfvok.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_-uXD4j7ITcsUZWT7_IDQ3A_AXLPWBCX"

# Privileged Supabase Service Role Key (Required for server-side writes like Add New Dish and Seed Menu)
# Obtain this from your Supabase Dashboard -> Project Settings -> API -> service_role secret
# Never expose this in client-side code or public repositories.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Session encryption secret (Required for signing serverless sessions on Vercel)
SESSION_SECRET="your_secure_random_session_secret_here"

# SMS Gateway Configuration (Required for live SMS dispatch in production)
# Twilio Provider (Configured in Vercel Environment Variables)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"

# Fast2SMS Provider (Alternative Indian SMS Gateway)
# FAST2SMS_API_KEY="your_fast2sms_api_key_here"

# Google Maps Platform Key (Used for live delivery tracking and route visualization)
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
GOOGLE_MAPS_PLATFORM_KEY="your_google_maps_api_key_here"
VITE_GOOGLE_MAPS_PLATFORM_KEY="your_google_maps_api_key_here"

# PhonePe Payment Gateway Configuration (Official Standard Checkout PG v1)
# Configure in Vercel Project Settings -> Environment Variables
# Obtained from your approved PhonePe Merchant Dashboard -> Developer Settings -> API Keys
PHONEPE_MERCHANT_ID="PGTESTPAYUAT"
PHONEPE_SALT_KEY="your_phonepe_salt_key_here"
PHONEPE_SALT_INDEX="1"
PHONEPE_ENV="SANDBOX" # Set to "PRODUCTION" for live transactions

# ==============================================================================
# EMAIL OTP & SMTP CONFIGURATION (Required for live Email OTP delivery)
# ==============================================================================
# Option A: Gmail App Password (Recommended for fast setup & testing)
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Generate an App Password under: https://myaccount.google.com/apppasswords
# 3. Choose App: "Mail" or custom name "Nuvvo", and copy the 16-character code
# 4. Set EMAIL_USER to your Gmail and EMAIL_PASS to the 16-character app password
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Nuvvo Food Delivery <your-email@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"

# Option B: Resend / Brevo / SendGrid / Custom SMTP Server
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-key"

# ==============================================================================
# META WHATSAPP CLOUD API CONFIGURATION (Automatic Order Notifications & Webhooks)
# ==============================================================================
WHATSAPP_ACCESS_TOKEN="your_meta_whatsapp_permanent_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verify_token"
WHATSAPP_GRAPH_API_VERSION="v21.0"
WHATSAPP_BUSINESS_RECIPIENT="+91XXXXXXXXXX"
# Optional: Meta App Secret for X-Hub-Signature-256 webhook verification
# WHATSAPP_APP_SECRET="your_meta_app_secret"

# ==============================================================================
# ADMIN MASTER CODE & OWNER RECOVERY CONFIGURATION (Server-Only Secrets)
# ==============================================================================
# Configure ONLY in Vercel Project Settings / server .env (never in client code).
ADMIN_PHONE=""
# Option A: Pre-hashed PBKDF2-SHA512 digest (pbkdf2$100000$salt$hash)
ADMIN_MASTER_CODE_HASH=""
# Option B: Server-side Master Code (hashed automatically via PBKDF2-SHA512 on read)
ADMIN_MASTER_CODE=""
