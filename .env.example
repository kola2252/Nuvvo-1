# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration for public.food_items centralized catalog
NEXT_PUBLIC_SUPABASE_URL="https://bitxmpjuetvfbhdyfvok.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_-uXD4j7ITcsUZWT7_IDQ3A_AXLPWBCX"
VITE_SUPABASE_URL="https://bitxmpjuetvfbhdyfvok.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_-uXD4j7ITcsUZWT7_IDQ3A_AXLPWBCX"

# Privileged Supabase Service Role Key (Required for server-side writes like Add New Dish and Seed Menu)
# Obtain this from your Supabase Dashboard -> Project Settings -> API -> service_role secret
# Never expose this in client-side code or public repositories.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Session encryption secret (Required for signing serverless sessions on Vercel)
SESSION_SECRET="your_secure_random_session_secret_here"

# SMS Gateway Configuration (Required for live SMS dispatch in production)
# Twilio Provider (Configured in Vercel Environment Variables)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"

# Fast2SMS Provider (Alternative Indian SMS Gateway)
# FAST2SMS_API_KEY="your_fast2sms_api_key_here"

# Google Maps Platform Key (Used for live delivery tracking and route visualization)
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
GOOGLE_MAPS_PLATFORM_KEY="your_google_maps_api_key_here"
VITE_GOOGLE_MAPS_PLATFORM_KEY="your_google_maps_api_key_here"

